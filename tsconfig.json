{
  "compilerOptions": {
    "strict": true,   
    "module": "NodeNext",
    "declaration": true,
    "removeComments": true,
    "allowSyntheticDefaultImports": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "ESNext",
    "sourceMap": true,
    "baseUrl": ".",
    "moduleResolution": "NodeNext", 
    "strictPropertyInitialization": false ,
    "outDir": "./build",
    "incremental": false,
    "useDefineForClassFields": true,
    "rootDir": ".",
    "lib": [
      "esnext.asynciterable",
      "dom",
      "ESNext.Array",
      "ESNext.String",
      "ESNext"
    ],
    "esModuleInterop": true,
    "importHelpers": true,
    "strictNullChecks": true
  },
  "exclude": [
    "node_modules",
    "out",
    "src/schema.ts",
    "bin",
    "./build/**/*",
    "tests"
  ]
}