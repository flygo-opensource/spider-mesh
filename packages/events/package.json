{
  "name": "@spider-mesh/events",
  "version": "3.0.0",
  "type": "module",
  "description": "Transport-independent event API for Spider Mesh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flygo-opensource/spider-mesh.git",
    "directory": "packages/events"
  },
  "author": "Duong Van Ba",
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./build/src/index.d.ts",
        "default": "./build/src/index.js"
      }
    }
  },
  "files": [
    "build/src/**/*",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf build && tsc -b tsconfig.json",
    "test:e2e": "bun test tests/*.test.ts"
  },
  "dependencies": {
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3"
  },
  "homepage": "https://github.com/flygo-opensource/spider-mesh/tree/main/packages/events#readme"
}
