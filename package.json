{
  "name": "@spider-mesh/core",
  "type": "module",
  "version": "1.0.146",
  "description": "Lightweight microservice framework for typescript, auto discovery, load-balancing, fault-torrent, multiple transporters",
  "main": "./build/src/index.js",
  "types": "./build/src/index.d.ts",
  "repository": {
    "url": "https://github.com/spider-mesh/core"
  },
  "files": [
    "build/**/*",
    "tsconfig.json",
    "yarn.lock"
  ],
  "devDependencies": {
    "@types/node": "^18.16.0",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.4"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./build/src/index.d.ts",
        "default": "./build/src/index.js"
      }
    }
  },
  "scripts": {
    "dev": "clear; node --no-warnings --es-module-specifier-resolution=node --experimental-specifier-resolution=node --loader ts-node/esm ",
    "build": "tsc -v; rm -rf build && tsc -b tsconfig.json"
  },
  "author": "Duong Van Ba",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.7.5",
    "buffer": "^6.0.3",
    "frame-stream": "^4.0.0",
    "react-native-uuid": "^2.0.2",
    "rxjs": "^7.8.1",
    "uuid": "^10.0.0"
  },
  "browser": {
    "crypto": false
  }
}
