{
  "name": "@spider-mesh/tcp",
  "type": "module",
  "version": "2.0.3",
  "description": "Lightweight microservice framework for typescript, auto discovery, load-balancing, fault-torrent, multiple transporters",
  "main": "./build/src/index.js",
  "types": "./build/src/index.d.ts",
  "repository": {
    "url": "https://github.com/spider-mesh/tcp"
  },
  "files": [
    "build/**/*",
    "tsconfig.json",
    "yarn.lock"
  ],
  "devDependencies": {
    "@types/node": "^22.10.5",
    "ts-node": "^10.9.2",
    "@types/bun": "^1.2.23",
    "typescript": "^5.8.2"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./build/src/index.d.ts",
        "default": "./build/src/index.js"
      }
    }
  },
  "scripts": {
    "dev": "clear; npx tsx ",
    "x": "clear; node --no-warnings --es-module-specifier-resolution=node --experimental-specifier-resolution=node --loader ts-node/esm ",
    "build": "tsc -v; rm -rf build && tsc -b tsconfig.json"
  },
  "author": "Duong Van Ba",
  "license": "ISC",
  "dependencies": {
    "@grpc/grpc-js": "^1.12.6",
    "@grpc/proto-loader": "^0.7.13",
    "@spider-mesh/core": "2.0.2",
    "@types/msgpack": "^0.0.34",
    "msgpackr": "^1.11.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
