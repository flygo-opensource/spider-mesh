{
  "name": "@spider-mesh/tcp",
  "type": "module",
  "version": "2.0.40",
  "description": "Lightweight microservice framework for typescript, auto discovery, load-balancing, fault-torrent, multiple transporters",
  "main": "./build/src/index.js",
  "types": "./build/src/index.d.ts",
  "repository": {
    "url": "https://github.com/spider-mesh/tcp",
    "rxjs": "^7.8.2",
    "reflect-metadata": "^0.2.2"
  },
  "files": [
    "build/**/*",
    "tsconfig.json",
    "yarn.lock"
  ],
  "peerDependencies": {
    "@spider-mesh/core": "^2.0.40"
  },
  "devDependencies": {
    "@spider-mesh/core": "^2.0.40",
    "@types/bun": "^1.2.23",
    "@types/msgpack": "^0.0.34",
    "@types/node": "^25.6.0",
    "typescript": "^5.8.2"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./build/src/index.d.ts",
        "default": "./build/src/index.js"
      }
    }
  },
  "scripts": {
    "dev": "clear; npx tsx ",
    "build": "tsc -v; rm -rf build && tsc -b tsconfig.json",
    "test:tcp": "bun run examples/tcp-smoke-test.ts",
    "test:tcp:e2e": "bun run examples/tcp-e2e-test.ts",
    "test:tcp:e2e:matrix": "bun run examples/tcp-e2e-matrix-test.ts",
    "test:tcp:e2e:reverse": "bun run examples/tcp-e2e-reverse-test.ts",
    "test:e2e": "bun test tests/tcp-transporters.e2e.test.ts && bun test tests/tcp-contracts.e2e.test.ts && bun test tests/tcp-spidermesh.e2e.test.ts && bun test tests/tcp-spidermesh-reverse.e2e.test.ts && bun test tests/tcp-spidermesh-matrix.e2e.test.ts && bun test tests/tcp-spidermesh-round-robin.e2e.test.ts"
  },
  "author": "Duong Van Ba",
  "license": "ISC",
  "dependencies": {
    "msgpackr": "^1.11.5"
  }
}